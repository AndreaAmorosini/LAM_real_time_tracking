# -------------------------------------------------------------------
# Server
# -------------------------------------------------------------------
LAM_WEB_HOST=127.0.0.1
LAM_WEB_PORT=7861
LAM_WEB_RELOAD=false
LAM_LOG_LEVEL=info

# -------------------------------------------------------------------
# Paths
# -------------------------------------------------------------------
LAM_OUTPUT_ROOT=output
LAM_OAC_OUTPUT_ROOT=output/open_avatar_chat
LAM_UPLOAD_DIR=output/live_uploads
LAM_TRACKING_OUTPUT_DIR=tracking_output_live
LAM_WEBGL_DIST_DIR=webgl_frontend/dist

# -------------------------------------------------------------------
# Routes
# -------------------------------------------------------------------
LAM_OAC_ASSETS_ROUTE=/oac_assets
LAM_WEBGL_ROUTE=/

# -------------------------------------------------------------------
# LAM model
# -------------------------------------------------------------------
LAM_CONFIG_PATH=configs/inference/lam-20k-8gpu.yaml
LAM_ARKIT_CONFIG_PATH=configs/inference/live-arkit.yaml
LAM_MODEL_NAME=./model_zoo/lam_models/releases/lam/lam-20k/step_045500/
LAM_DEVICE=cuda
LAM_RENDER_SIZE=512
LAM_CAMERA_MOTION_DIR=assets/sample_motion/export/Look_In_My_Eyes/

# -------------------------------------------------------------------
# Blender / OAC export
# -------------------------------------------------------------------
LAM_BLENDER_PATH=thirdparties/blender/blender-4.0.2-linux-x64/blender

# -------------------------------------------------------------------
# Tracking
# -------------------------------------------------------------------
LAM_CAMERA_INDEX=0
LAM_CAPTURE_WIDTH=320
LAM_CAPTURE_HEIGHT=240
LAM_CAPTURE_FPS=30
LAM_DEFAULT_UI_FPS=20
LAM_WEBGL_UI_FPS=30
LAM_JPEG_QUALITY=80
LAM_MAPPING_MODE=stable

# -------------------------------------------------------------------
# Landmark-derived general
# -------------------------------------------------------------------
LAM_DERIVED_NEUTRAL_FRAMES=20
LAM_DERIVED_ALPHA=0.60

# -------------------------------------------------------------------
# Jaw / speech tuning
# -------------------------------------------------------------------
LAM_JAW_DERIVED_WEIGHT=0.40
LAM_JAW_MIN=0.04
LAM_JAW_CAP=0.62
LAM_STABLE_JAW_DEADZONE=0.04
LAM_STABLE_JAW_GAIN=0.70

# -------------------------------------------------------------------
# Speech landmark tuning
# currently still mostly hardcoded, useful for next refactor
# -------------------------------------------------------------------
LAM_SPEECH_OPEN_GAIN=2.35
LAM_SPEECH_OPEN_WEIGHT_TO_JAW=0.85
LAM_BIG_JAW_GAIN=1.75
LAM_BIG_JAW_DEADZONE=0.20
LAM_BIG_JAW_POWER=1.45
LAM_LANDMARK_JAW_CAP=0.75

# -------------------------------------------------------------------
# O / U vowel tuning
# currently still mostly hardcoded, useful for next refactor
# -------------------------------------------------------------------
LAM_MOUTH_NARROW_GAIN=4.2
LAM_VOWEL_O_FUNNEL_GAIN=0.90
LAM_VOWEL_O_PUCKER_GAIN=0.35
LAM_VOWEL_O_JAW_GAIN=0.28
LAM_VOWEL_U_PUCKER_GAIN=0.95
LAM_VOWEL_U_FUNNEL_GAIN=0.30

# -------------------------------------------------------------------
# Stable WebGL postprocess tuning
# currently mostly hardcoded in app_live_web.py
# -------------------------------------------------------------------
LAM_STABLE_MOUTH_FUNNEL_DEADZONE=0.035
LAM_STABLE_MOUTH_PUCKER_DEADZONE=0.035
LAM_STABLE_MOUTH_LOWER_DOWN_DEADZONE=0.025
LAM_STABLE_MOUTH_STRETCH_DEADZONE=0.025

LAM_STABLE_MOUTH_FUNNEL_GAIN=1.00
LAM_STABLE_MOUTH_PUCKER_GAIN=1.00
LAM_STABLE_MOUTH_LOWER_DOWN_GAIN=0.85
LAM_STABLE_MOUTH_STRETCH_GAIN=1.05

# -------------------------------------------------------------------
# Common mouth conflict tuning
# -------------------------------------------------------------------
LAM_MOUTHCLOSE_JAW_THRESHOLD=0.06
LAM_MOUTHCLOSE_JAW_REDUCTION_RANGE=0.12
LAM_PUCKER_FUNNEL_DOMINANCE_RATIO=1.35
LAM_PUCKER_FUNNEL_WEAKER_SCALE=0.75
LAM_ROUNDING_MOUTHCLOSE_THRESHOLD=0.06
LAM_ROUNDING_MOUTHCLOSE_RANGE=0.35
LAM_ROUNDING_MOUTHCLOSE_SCALE=0.75
